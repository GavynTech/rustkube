[Unit]
Description=RustKube scheduler
Documentation=https://github.com/GavynTech/rustkube
After=rk-api.service
Wants=rk-api.service
PartOf=rustkube.target

[Service]
ExecStart=@BINDIR@/rk-scheduler --config @CONFDIR@/scheduler.yaml
Restart=on-failure
RestartSec=2
User=root
# Network-only: no writes, no extra privileges.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=rustkube.target
